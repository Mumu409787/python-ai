# 复制为 .env 后填入真实值。.env 已在 .gitignore 中，切勿提交。
#   cp .env.example .env

# --- 对话模型：DeepSeek（OpenAI 协议兼容）---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- 向量模型：硅基流动 BAAI/bge-m3 ---
# 注意：bge-m3 不接受 dimensions 参数，传了会 400（code 20015），原生返回 1024 维
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# --- 向量库：Qdrant（本项目 docker compose 起在 6335/6336）---
# 注意：6333/6334 是 Java 项目 java-ai-rag 占用的，别填错
QDRANT_URL=http://localhost:6335
QDRANT_COLLECTION=python_ai_docs

# --- 关系库：PostgreSQL + pgvector（docker compose 起在 5432）---
# 与 Qdrant 二选一或并用：pgvector 适合「元数据 + 向量」同库，少一个中间件
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123456
POSTGRES_DB=python_ai
# bge-m3 原生 1024 维，建表用 vector(1024)
EMBEDDING_DIM=1024

# --- 缓存：Redis（docker compose 起在 6380，DB 0 自用）---
REDIS_URL=redis://localhost:6380/0

# --- 检索调参（全部可选；不写就用 src/python_ai/config.py 里的默认值）---
# 变量名 = config.py 字段名的大写形式。常用几项：
# CHUNK_SIZE=800                  # 切片大小（字符）
# CHUNK_OVERLAP=150               # 切片重叠
# RETRIEVAL_TOP_K=5               # 最终注入 prompt 的片段数
# RETRIEVAL_SCORE_THRESHOLD=0.45  # 向量召回阈值；实测标定值，换语料要重新标
# RERANK_ENABLED=true             # 关掉则退回纯向量检索
# RERANK_RELATIVE_CUTOFF=0.1      # 只保留 rerank 分数 >= top1*该比例的命中
# CHAT_MAX_TOKENS=4096            # deepseek-flash 是推理模型，思维链与正文共享此额度

# --- 可观测：Langfuse（可选，不填则不上报）---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
