# 复制为 .env 后填入真实值。.env 已在 .gitignore 中，切勿提交。
#   cp .env.example .env

# --- 对话模型：DeepSeek（OpenAI 协议兼容）---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- 向量模型：硅基流动 BAAI/bge-m3 ---
# 注意：bge-m3 不接受 dimensions 参数，传了会 400（code 20015），原生返回 1024 维
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# --- 向量库：Qdrant（本项目 docker compose 起在 6335/6336）---
# 注意：6333/6334 是 Java 项目 java-ai-rag 占用的，别填错
QDRANT_URL=http://localhost:6335
QDRANT_COLLECTION=python_ai_docs

# --- 关系库：PostgreSQL + pgvector（docker compose 起在 5432）---
# 与 Qdrant 二选一或并用：pgvector 适合「元数据 + 向量」同库，少一个中间件
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123456
POSTGRES_DB=python_ai
# bge-m3 原生 1024 维，建表用 vector(1024)
EMBEDDING_DIM=1024

# --- 缓存：Redis（docker compose 起在 6380，DB 0 自用）---
REDIS_URL=redis://localhost:6380/0

# --- 检索调参（全部可选；不写就用 src/python_ai/config.py 里的默认值）---
# 变量名 = config.py 字段名的大写形式。常用几项：
# CHUNK_SIZE=800                  # 切片大小（字符）
# CHUNK_OVERLAP=150               # 切片重叠
# RETRIEVAL_TOP_K=5               # 最终注入 prompt 的片段数
# RETRIEVAL_SCORE_THRESHOLD=0.45  # 向量召回阈值；实测标定值，换语料要重新标
# RERANK_ENABLED=true             # 关掉则退回纯向量检索
# RERANK_RELATIVE_CUTOFF=0.1      # 只保留 rerank 分数 >= top1*该比例的命中
# HYBRID_ENABLED=true            # BM25 + 向量，RRF 按排名融合；false 恢复向量召回
# BM25_CANDIDATE_K=20            # BM25 候选数量（1～100）
# HYBRID_RRF_K=60                # RRF 平滑常数，与 RETRIEVAL_TOP_K 不同
# QUERY_REWRITE_ENABLED=true     # 仅有历史的 RAG 追问额外调用 LLM，失败回退原问题
# QUERY_REWRITE_TIMEOUT=8        # 改写超时秒数
# QUERY_REWRITE_HISTORY_TURNS=3  # 最多使用最近几轮历史，每条问题/回答截取 600 字符
# CHAT_MAX_TOKENS=4096            # deepseek-flash 是推理模型，思维链与正文共享此额度

# --- 可观测：Langfuse（可选，不填则不上报）---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=true
# 默认仅上报长度、模型、耗时、来源数量与 token 等，不上报问答/资料正文。
LANGFUSE_CAPTURE_CONTENT=false
MEMORY_BACKEND=langgraph
SESSION_TTL_SECONDS=3600
SESSION_MAX_TURNS=10
CLASSIFIER_ENABLED=true
OCR_ENABLED=true
OCR_LANGUAGE=chi_sim+eng
# TESSERACT_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe
# OCR_TESSDATA_DIR=D:/Projects/python-ai/.tools/tessdata
OCR_TIMEOUT_SECONDS=20
OCR_TOTAL_TIMEOUT_SECONDS=60
OCR_MAX_PAGES=30
OCR_MAX_PIXELS=20000000
OCR_PDF_DPI=200

# --- 其它项目调用知序（留空则仅禁用外部 /ask；原工作台不受影响）---
# 在 PowerShell 运行 .\.venv\Scripts\python.exe scripts/setup_integration.py 自动生成到本机 .env
# 至少 32 字符；这是知序的接入密钥，不是 DeepSeek/SiliconFlow 的模型密钥。
INTEGRATION_API_KEY=
INTEGRATION_TIMEOUT_SECONDS=180
# CLASSIFIER_MODEL_PATH=D:/Projects/python-ai/training/artifacts/question_classifier.json
